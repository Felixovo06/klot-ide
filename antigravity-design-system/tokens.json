  "motion": {
    "ease": {
      "expoOut": "cubic-bezier(0.16, 1, 0.3, 1)",
      "cubicOut": "cubic-bezier(0.23, 1, 0.32, 1)",
      "standard": "cubic-bezier(0.4, 0, 0.2, 1)",
      "out": "cubic-bezier(0, 0, 0.2, 1)",
      "in": "cubic-bezier(0.4, 0, 1, 1)"
    },
    "duration": {
      "peekEnter": 200,
      "peekExit": 160,
      "fast": 150,
      "normal": 150,
      "slow": 250,
      "splitter": 80
    }
  },
